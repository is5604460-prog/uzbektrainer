<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ўзбек тили — Сессия 2026</title>
<style>
  :root {
    --bg: #0f0f13;
    --card: #1a1a22;
    --card2: #22222e;
    --accent: #7c6af7;
    --accent2: #a78bfa;
    --green: #22c55e;
    --red: #ef4444;
    --text: #e2e8f0;
    --muted: #94a3b8;
    --border: #2d2d3d;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; min-height: 100vh; }

  /* HEADER */
  .header { background: var(--card); border-bottom: 1px solid var(--border); padding: 14px 20px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 100; }
  .header h1 { font-size: 16px; font-weight: 700; color: var(--accent2); }
  .header .sub { font-size: 11px; color: var(--muted); margin-top: 2px; }
  .progress-bar { width: 100%; height: 3px; background: var(--border); position: fixed; top: 0; left: 0; z-index: 200; }
  .progress-fill { height: 100%; background: linear-gradient(90deg, var(--accent), var(--accent2)); transition: width 0.4s ease; }

  /* TABS */
  .tabs { display: flex; gap: 6px; padding: 12px 16px; background: var(--card2); border-bottom: 1px solid var(--border); }
  .tab { flex: 1; padding: 8px 6px; border: 1px solid var(--border); border-radius: 8px; background: none; color: var(--muted); font-size: 12px; font-weight: 600; cursor: pointer; transition: all 0.2s; text-align: center; }
  .tab.active { background: var(--accent); border-color: var(--accent); color: #fff; }
  .tab:hover:not(.active) { border-color: var(--accent); color: var(--accent2); }

  /* STATS BAR */
  .stats { display: flex; gap: 8px; padding: 10px 16px; background: var(--card); border-bottom: 1px solid var(--border); }
  .stat { flex: 1; text-align: center; }
  .stat-val { font-size: 18px; font-weight: 700; }
  .stat-lbl { font-size: 10px; color: var(--muted); margin-top: 2px; }
  .stat-val.green { color: var(--green); }
  .stat-val.red { color: var(--red); }
  .stat-val.accent { color: var(--accent2); }

  /* QUESTION CARD */
  .main { padding: 16px; max-width: 700px; margin: 0 auto; }
  .q-card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 20px; margin-bottom: 14px; }
  .q-meta { font-size: 11px; color: var(--muted); margin-bottom: 10px; display: flex; justify-content: space-between; }
  .q-text { font-size: 15px; line-height: 1.6; font-weight: 500; }

  /* OPTIONS */
  .options { display: flex; flex-direction: column; gap: 8px; margin-bottom: 14px; }
  .opt { background: var(--card2); border: 1.5px solid var(--border); border-radius: 10px; padding: 12px 14px; cursor: pointer; display: flex; align-items: flex-start; gap: 10px; transition: all 0.18s; font-size: 14px; line-height: 1.5; text-align: left; color: var(--text); width: 100%; }
  .opt:hover { border-color: var(--accent); background: #1e1e2e; }
  .opt.correct { border-color: var(--green) !important; background: rgba(34,197,94,0.1) !important; color: var(--green); }
  .opt.wrong { border-color: var(--red) !important; background: rgba(239,68,68,0.1) !important; color: var(--red); }
  .opt.reveal { border-color: var(--green) !important; background: rgba(34,197,94,0.07) !important; }
  .opt-letter { font-weight: 700; color: var(--accent2); min-width: 18px; flex-shrink: 0; }

  /* BUTTONS */
  .btn-row { display: flex; gap: 8px; margin-bottom: 14px; flex-wrap: wrap; }
  .btn { padding: 10px 18px; border-radius: 9px; border: 1px solid var(--border); background: var(--card2); color: var(--text); font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s; flex: 1; min-width: 90px; }
  .btn:hover { border-color: var(--accent); color: var(--accent2); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .btn.primary:hover { background: #6855e8; }
  .btn.danger { border-color: var(--red); color: var(--red); }

  /* FLASH (Learn mode) */
  .flash-card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 28px 20px; margin-bottom: 14px; min-height: 160px; cursor: pointer; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; transition: transform 0.15s; }
  .flash-card:hover { transform: scale(1.01); }
  .flash-card.flipped { border-color: var(--accent); }
  .flash-front { font-size: 16px; font-weight: 600; line-height: 1.6; }
  .flash-back { color: var(--green); font-size: 15px; font-weight: 600; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border); width: 100%; display: none; }
  .flash-card.flipped .flash-back { display: block; }
  .flash-hint { font-size: 11px; color: var(--muted); margin-top: 8px; }

  /* EMPTY */
  .empty { text-align: center; padding: 60px 20px; color: var(--muted); }
  .empty-icon { font-size: 48px; margin-bottom: 12px; }

  /* SHUFFLE */
  .toolbar { display: flex; gap: 8px; padding: 10px 16px; background: var(--card2); border-bottom: 1px solid var(--border); align-items: center; flex-wrap: wrap; }
  .toolbar-label { font-size: 12px; color: var(--muted); white-space: nowrap; }
  .toggle { background: var(--card); border: 1px solid var(--border); border-radius: 6px; padding: 5px 10px; color: var(--muted); font-size: 12px; cursor: pointer; white-space: nowrap; }
  .toggle.on { background: var(--accent); border-color: var(--accent); color: #fff; }

  /* MODAL */
  .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 300; align-items: center; justify-content: center; padding: 20px; }
  .modal-overlay.show { display: flex; }
  .modal { background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: 28px 24px; max-width: 360px; width: 100%; text-align: center; }
  .modal h2 { font-size: 22px; margin-bottom: 8px; }
  .modal p { color: var(--muted); font-size: 14px; margin-bottom: 20px; }
  .modal-stats { display: flex; gap: 12px; margin-bottom: 20px; }
  .modal-stat { flex: 1; background: var(--card2); border-radius: 10px; padding: 12px; }
  .modal-stat .v { font-size: 24px; font-weight: 700; }
  .modal-stat .l { font-size: 11px; color: var(--muted); }
</style>
</head>
<body>

<div class="progress-bar"><div class="progress-fill" id="pbar"></div></div>

<div class="header">
  <div>
    <div class="header h1" style="font-size:16px;font-weight:700;color:#a78bfa">Ўзбек тили</div>
    <div class="sub">Сессия 2026 · 366 савол</div>
  </div>
  <button class="btn danger" style="flex:none;padding:7px 12px;font-size:12px" id="resetBtn">Сброс</button>
</div>

<div class="tabs">
  <button class="tab active" id="tabTest" onclick="setMode('test')">📝 Тест</button>
  <button class="tab" id="tabLearn" onclick="setMode('learn')">📖 Учить</button>
  <button class="tab" id="tabErrors" onclick="setMode('errors')">❌ Ошибки</button>
</div>

<div class="toolbar">
  <span class="toolbar-label">Перемешать:</span>
  <button class="toggle" id="shuffleToggle" onclick="toggleShuffle()">Выкл</button>
  <span class="toolbar-label" style="margin-left:8px">Осталось:</span>
  <span id="remaining" style="font-size:12px;color:#a78bfa;font-weight:700"></span>
</div>

<div class="stats">
  <div class="stat"><div class="stat-val accent" id="statTotal">0</div><div class="stat-lbl">Всего</div></div>
  <div class="stat"><div class="stat-val green" id="statCorrect">0</div><div class="stat-lbl">Верно</div></div>
  <div class="stat"><div class="stat-val red" id="statWrong">0</div><div class="stat-lbl">Ошибок</div></div>
  <div class="stat"><div class="stat-val accent" id="statPct">0%</div><div class="stat-lbl">Точность</div></div>
</div>

<div class="main" id="mainArea"></div>

<div class="modal-overlay" id="finModal">
  <div class="modal">
    <div style="font-size:40px;margin-bottom:10px">🎉</div>
    <h2>Готово!</h2>
    <p>Вы прошли все вопросы</p>
    <div class="modal-stats">
      <div class="modal-stat"><div class="v green" id="mCorrect">0</div><div class="l">Верно</div></div>
      <div class="modal-stat"><div class="v red" id="mWrong">0</div><div class="l">Ошибок</div></div>
      <div class="modal-stat"><div class="v accent" id="mPct">0%</div><div class="l">Точность</div></div>
    </div>
    <div class="btn-row">
      <button class="btn primary" onclick="restartAll()">Заново</button>
      <button class="btn" onclick="document.getElementById('finModal').classList.remove('show')">Закрыть</button>
    </div>
  </div>
</div>

<script>
const RAW = "";
let ALL = [];
try {
  const bytes = atob(RAW);
  const arr = new Uint8Array(bytes.length);
  for (let i = 0; i < bytes.length; i++) arr[i] = bytes.charCodeAt(i);
  ALL = JSON.parse(new TextDecoder('utf-8').decode(arr));
} catch(e) { document.body.innerHTML = '<p style="color:red;padding:20px">Ошибка загрузки данных: ' + e + '</p>'; }

let mode = 'test';
let queue = [];
let errors = [];
let correct = 0, wrong = 0;
let answered = false;
let current = null;
let shuffle = false;
let flashFlipped = false;

function setMode(m) {
  mode = m;
  ['test','learn','errors'].forEach(x => {
    document.getElementById('tab' + x.charAt(0).toUpperCase() + x.slice(1)).classList.toggle('active', x === m);
  });
  buildQueue();
  render();
}

function toggleShuffle() {
  shuffle = !shuffle;
  const t = document.getElementById('shuffleToggle');
  t.textContent = shuffle ? 'Вкл' : 'Выкл';
  t.classList.toggle('on', shuffle);
  buildQueue();
  render();
}

function buildQueue() {
  if (mode === 'errors') {
    queue = [...errors];
  } else {
    queue = [...ALL];
  }
  if (shuffle) queue = queue.sort(() => Math.random() - 0.5);
  current = 0;
}

function restartAll() {
  correct = 0; wrong = 0; errors = [];
  document.getElementById('finModal').classList.remove('show');
  buildQueue();
  render();
}

function updateStats() {
  const tot = correct + wrong;
  document.getElementById('statTotal').textContent = tot;
  document.getElementById('statCorrect').textContent = correct;
  document.getElementById('statWrong').textContent = wrong;
  document.getElementById('statPct').textContent = tot ? Math.round(correct/tot*100)+'%' : '0%';
  const rem = queue.length - current;
  document.getElementById('remaining').textContent = rem + ' / ' + queue.length;
  const pct = queue.length ? (current / queue.length * 100) : 0;
  document.getElementById('pbar').style.width = pct + '%';
}

function render() {
  updateStats();
  const area = document.getElementById('mainArea');
  if (!queue.length) {
    if (mode === 'errors') {
      area.innerHTML = '<div class="empty"><div class="empty-icon">✅</div><p>Ошибок нет!</p></div>';
    } else {
      area.innerHTML = '<div class="empty"><div class="empty-icon">📭</div><p>Нет вопросов</p></div>';
    }
    return;
  }
  if (current >= queue.length) {
    // finished
    document.getElementById('mCorrect').textContent = correct;
    document.getElementById('mWrong').textContent = wrong;
    const tot = correct + wrong;
    document.getElementById('mPct').textContent = tot ? Math.round(correct/tot*100)+'%' : '0%';
    document.getElementById('finModal').classList.add('show');
    area.innerHTML = '<div class="empty"><div class="empty-icon">🏁</div><p>Все вопросы пройдены!</p><br><button class="btn primary" onclick="restartAll()">Заново</button></div>';
    return;
  }

  const q = queue[current];
  answered = false;
  flashFlipped = false;

  if (mode === 'learn') {
    renderFlash(q, area);
  } else {
    renderTest(q, area);
  }
  updateStats();
}

function renderTest(q, area) {
  const letters = ['A','B','C','D'];
  let optHtml = '';
  letters.forEach(l => {
    if (q.options[l]) {
      optHtml += `<button class="opt" id="opt${l}" onclick="answer('${l}','${q.answer}')"><span class="opt-letter">${l}</span><span>${q.options[l]}</span></button>`;
    }
  });

  area.innerHTML = `
    <div class="q-card">
      <div class="q-meta"><span>Вопрос ${current+1} / ${queue.length}</span><span>#${q.id}</span></div>
      <div class="q-text">${q.question}</div>
    </div>
    <div class="options" id="opts">${optHtml}</div>
    <div class="btn-row" id="nav" style="display:none">
      <button class="btn primary" onclick="next()">Следующий →</button>
    </div>
  `;
}

function answer(chosen, correct_ans) {
  if (answered) return;
  answered = true;
  const letters = ['A','B','C','D'];
  letters.forEach(l => {
    const el = document.getElementById('opt'+l);
    if (!el) return;
    el.style.pointerEvents = 'none';
    if (l === correct_ans) el.classList.add('correct');
    else if (l === chosen && l !== correct_ans) el.classList.add('wrong');
  });
  if (chosen === correct_ans) {
    correct++;
  } else {
    wrong++;
    const q = queue[current];
    if (!errors.find(e => e.id === q.id)) errors.push(q);
  }
  document.getElementById('nav').style.display = 'flex';
  updateStats();
}

function next() {
  current++;
  render();
}

function renderFlash(q, area) {
  area.innerHTML = `
    <div class="flash-card" id="fcard" onclick="flipCard()">
      <div class="flash-front">${q.question}</div>
      <div class="flash-back" id="fback">${q.options[q.answer]} (${q.answer})</div>
      <div class="flash-hint" id="fhint">Нажмите, чтобы открыть ответ</div>
    </div>
    <div class="btn-row">
      <button class="btn" onclick="next()">Пропустить</button>
      <button class="btn primary" id="knowBtn" style="display:none" onclick="markKnow()">Знаю ✓</button>
      <button class="btn danger" id="dontBtn" style="display:none" onclick="markDont()">Не знаю ✗</button>
    </div>
    <div class="q-card" style="font-size:13px;color:var(--muted)">
      <b style="color:var(--text)">Варианты:</b><br>
      ${['A','B','C','D'].filter(l=>q.options[l]).map(l=>`<span style="color:${l===q.answer?'var(--green)':'inherit'}">${l}: ${q.options[l]}</span>`).join('<br>')}
    </div>
  `;
}

function flipCard() {
  if (flashFlipped) return;
  flashFlipped = true;
  document.getElementById('fcard').classList.add('flipped');
  document.getElementById('fhint').style.display = 'none';
  document.getElementById('knowBtn').style.display = '';
  document.getElementById('dontBtn').style.display = '';
}

function markKnow() { correct++; updateStats(); current++; render(); }
function markDont() {
  wrong++; updateStats();
  const q = queue[current];
  if (!errors.find(e => e.id === q.id)) errors.push(q);
  current++; render();
}

document.getElementById('resetBtn').addEventListener('click', function() {
  if (confirm('Сбросить весь прогресс?')) restartAll();
});

// Init
buildQueue();
render();
</script>
</body>
</html>
